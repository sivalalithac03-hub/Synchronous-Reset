//======================================================
// D Flip-Flop with Synchronous Active-High Reset
// Positive-edge triggered
//======================================================

module d_flip_flop_sync_reset (
    input  wire clk,
    input  wire reset,
    input  wire d,
    output reg q,
    output wire q_bar
);

    // Synchronous reset
    always @(posedge clk) begin
        if (reset)
            q <= 1'b0;
        else
            q <= d;
    end

    // Complementary output
    assign q_bar = ~q;

endmodule